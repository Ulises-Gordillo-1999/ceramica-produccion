# Base de Datos PostgreSQL 16
POSTGRES_USER=ceramica_admin
POSTGRES_PASSWORD=<tu-password-segura-aqui>
POSTGRES_DB=ceramica_prod_db
DATABASE_URL=postgresql://ceramica_admin:<tu-password-segura-aqui>@localhost:5435/ceramica_prod_db

# Seguridad y Autenticación JWT
JWT_SECRET=clave_secreta_jwt_super_segura_minimo_32_caracteres_xyz123!

# Credenciales de Seed Inicial (Solo para entorno de desarrollo / primer despliegue)
SEED_DEFAULT_PASSWORD=<password-temporal-seed>
